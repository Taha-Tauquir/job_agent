+def _normalize_time_posted(value: str | None) -> str | None:
+    if not value:
+        return None
+    value = value.strip()
+    return _TIME_POSTED_ALIASES.get(value.lower(), value)
+
+
+def _days_to_time_posted(days: int) -> str:
+    return f"r{max(days, 0) * 86400}"
